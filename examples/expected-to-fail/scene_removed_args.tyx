// Expected to fail: E011 (Scene). `width` / `height` / `bg` are not valid
// arguments for `#scene` (they are treated as if they never existed — a
// regular parse error). The canvas comes from `#show: candy` and the
// background from `#set page(fill: ...)` inside the scene body.
#import "@preview/candy:0.1.0": *
#show: candy

#scene(width: 16cm, height: 9cm, bg: rgb("#05060f"))[
  #mobject("a", circle(radius: 1cm, fill: white))
]
